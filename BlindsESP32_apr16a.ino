#include "thingProperties.h"
// driver for the TB6612FNG motor controller (local, see motor_driver.h)
#include "motor_driver.h"

// TB6612FNG pin assignments (the PWMx pins are used as plain on/off enables)
#define AIN1 16
#define AIN2 17
#define PWMA 5
#define BIN1 4
#define BIN2 0
#define PWMB 2
#define STBY 18

// Magnet (reed) sensor inputs, one per motor. Used to detect when a motor has
// stopped turning (stall / end of travel).
#define MAGL 32   // sensor for motor 2 (left), moved off GPIO12 for pull-up/strap safety
#define MAGR 14   // sensor for motor 1 (right)

// motor direction (the driver always runs at full speed)
#define BLIND_UP 1
#define BLIND_DOWN (-1)

// maximum run time per motor; a motor normally stops earlier, when its sensor
// shows it has stalled at the end of travel
#define BLIND_STEP_DURATION 10 //ms
#define BLIND_DOWN_SECONDS 10
#define BLIND_DOWN_LOOP_COUNT (BLIND_DOWN_SECONDS*100)
#define BLIND_UP_SECONDS 10
#define BLIND_UP_LOOP_COUNT (BLIND_UP_SECONDS*100)

// these constants are used to allow you to make your motor configuration 
// line up with function names like forward.  Value can be 1 or -1
const int offsetA = 1;
const int offsetB = 1;

// Initializing motor globals
Motor motor1;// = Motor(AIN1, AIN2, PWMA, offsetA, STBY);
Motor motor2;// = Motor(BIN1, BIN2, PWMB, offsetB, STBY);


// LED on GPIO19
int ledPin = 19; 
int iLoop = 0;
int iBLindLoop1 = 0;
int iBLindLoop2 = 0;
//int iBLindUpDuration = BLIND_STEP_DURATION;
//int iBLindDownDuration = BLIND_STEP_DURATION;
int iBlindDirection = 0;
bool bBlindsMoving = false;
bool bManualMotor = false; //false is left, true is right

#define STATE_OPENED 2
#define STATE_CLOSED 1
#define STATE_UNKNOWN 0
int iBlindState = STATE_UNKNOWN;

int heartbeatCount = 0;

void BlindsMove(int iDirection, int iDuration);
void BlindMove(Motor myMotor, int iDirection, int iDuration);
void BlindsMove(int iDirection);
void BlindsStop(void);
void BlindMove(Motor myMotor, int iDirection);
void BlindStop(Motor myMotor);
bool isLeftMotorMoving(void);
bool isRightMotorMoving(void);


void setup() {
  // Initialize serial and wait for port to open:
  Serial.begin(115200);
  // This delay gives the chance to wait for a Serial Monitor without blocking if none is found
  delay(1000); 
  
  // Set LED as output
  pinMode(ledPin, OUTPUT);
  Serial.println("\n\n***Booted***\n");

  // Initializing motors.
  motor1 = Motor(AIN1, AIN2, PWMA, offsetA, STBY);
  motor2 = Motor(BIN1, BIN2, PWMB, offsetB, STBY);

  pinMode(MAGR,INPUT);
  pinMode(MAGL,INPUT);

  // Defined in thingProperties.h
  initProperties();

  // Connect to Arduino IoT Cloud
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  
  /*
     The following function allows you to obtain more information
     related to the state of network and IoT Cloud connection and errors
     the higher number the more granular information you’ll get.
     Maximum is 4
 */
  setDebugMessageLevel(4);
  ArduinoCloud.printDebugInfo();
}

void loop() {
  ArduinoCloud.update();
  static int waitL = 0;
  static int waitR = 0;
  // Your code here 
  
  digitalWrite(ledPin, (iLoop & 0x01));
  
  //bRightMoving = isRightMotorMoving();
  
  if(iBLindLoop1 > 0)
  {
    bool bRightMoving = isRightMotorMoving();
    //Serial.print("Blind Loop1 = ");
    //Serial.println(iBLindLoop1);
    //BlindsMove(iBlindDirection);
    BlindMove(motor1, iBlindDirection);
    iBLindLoop1--;

    Serial.print("waitR = ");
    Serial.print(waitR);
    if (!bRightMoving && (waitR > 30))
    {
      Serial.println("Motor 1 Stall"); 
      iBLindLoop1 = 0;
    }

    if (iBLindLoop1 == 0)
    {
      if(iBlindDirection == BLIND_DOWN)
        iBLindLoop2 = BLIND_DOWN_LOOP_COUNT;
      else
       iBLindLoop2 = BLIND_UP_LOOP_COUNT;
      //BlindStop(motor1);
      Serial.println("Motor 1 Done");
      BlindsStop();
      waitR = 0;
    }
    waitR++;
  }
  else if(iBLindLoop2 > 0)
  {
    bool bLeftMoving = isLeftMotorMoving();
    
    //Serial.print("Blind Loop2 = ");
    //Serial.println(iBLindLoop2);
    BlindMove(motor2, iBlindDirection);
    iBLindLoop2--;

    Serial.print("waitL = ");
    Serial.print(waitL);
    if (!bLeftMoving && (waitL > 30))
    {
      Serial.println("Motor 2 Stall"); 
      iBLindLoop2 = 0;
    }
    
    if (iBLindLoop2 == 0)
    {
      Serial.println("Motor 2 Done");
      bBlindsMoving = false;
      //BlindStop(motor2);
      BlindsStop();
      waitL = 0;
    }
    waitL++;
  }


  delay(10); //10ms delay during each loop

  if(heartbeatCount == 999){ //10s update
    //Serial.print("Heartbeat=");
    //Serial.println(heartbeat);
    heartbeatCount = 0;    
    uptime = uptime+10;
    Serial.print("Uptime=");
    Serial.println(uptime);
  }
  heartbeatCount++;

}

// note this func may be succeptible to bouncing
// if the mag is close to the sensor
bool isLeftMotorMoving(void)
{
  static int enc = 0;
  static unsigned int ticks = 0;
  
  int tmp = digitalRead(MAGL);
  ticks++;
  
  if (enc != tmp)
  {
    ticks = 0;
    enc = tmp;
  }

  Serial.print("Motor Left ticks = ");
  Serial.println(ticks);
  
  if (ticks > 30)
  {
    return false;
  }
  else
  {
    return true;
  }
}

// note this func may be succeptible to bouncing
// if the mag is close to the sensor
bool isRightMotorMoving(void)
{
  static int enc = 0;
  static unsigned int ticks = 0;
  
  int tmp = digitalRead(MAGR);
  ticks++;
  
  if (enc != tmp)
  {
    ticks = 0;
    enc = tmp;
  }

  Serial.print("Motor Right ticks = ");
  Serial.println(ticks);
  
  if (ticks > 30)
  {
    return false;
  }
  else
  {
    return true;
  }
}


void SetBlindState(int newState)
{
  
  if (newState == iBlindState)
  {
    Serial.print("Blinds already ");
    if (newState == STATE_CLOSED)
      Serial.println("Closed");
    else
      Serial.println("Opened");
  }
  else
  {
    Serial.println("Blinds State Change");
    iBlindState = newState;
    
    bBlindsMoving = true;
    if (newState == STATE_CLOSED)
    {
      Serial.println("Blinds Down");
      iBlindDirection = BLIND_DOWN;
      iBLindLoop1 = BLIND_DOWN_LOOP_COUNT;
      
    }
    else
    {
      Serial.println("Blinds Up");
      iBlindDirection = BLIND_UP;
      iBLindLoop1 = BLIND_UP_LOOP_COUNT;
    }
  }
}


/*
  Since Blinds is READ_WRITE variable, onBlindsChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onBlindsChange()  {
  // Add your code here to act upon Blinds change
  
  static int iIgnorefirst = 0;
  Serial.println("Blinds Change");
  if (iIgnorefirst == 0)
  {
    Serial.println("Ignoring first Blind Change message");
    iIgnorefirst++;
  }
  else if(bBlindsMoving)
  {
    Serial.println("Ignoring, cuz already moving");
  }
  else
  {
    blindSwitch = blinds;
    if(blinds)
      SetBlindState(STATE_OPENED);
    else
      SetBlindState(STATE_CLOSED);
  }
  
}


/*
  Since BlindSwitch is READ_WRITE variable, onBlindSwitchChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onBlindSwitchChange() {
  // Add your code here to act upon LightSwitch change
  Serial.println("Switch change");
  bManualMotor = blindSwitch;
}

/*
  Since Down is READ_WRITE variable, onDownChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onDownChange()  {
  // Add your code here to act upon Down change
  
  static int iIgnorefirst = 0;
  if (iIgnorefirst == 0)
  {
    iIgnorefirst++;
    return;
  }
  
  Serial.println("Down Button Pressed");
  if(bBlindsMoving)
  {
    Serial.println("Ignoring Down Button");
    return;
  }
  
  if (down)
    if (bManualMotor)
      BlindMove(motor1, BLIND_DOWN);
    else
      BlindMove(motor2, BLIND_DOWN);
  else
  {
    BlindsStop();
  }
}

/*
  Since Up is READ_WRITE variable, onUpChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onUpChange()  {
  // Add your code here to act upon Up change
  
  static int iIgnorefirst = 0;
  if (iIgnorefirst == 0)
  {
    iIgnorefirst++;
    return;
  }
  
  Serial.println("Up Button Pressed");
  if(bBlindsMoving)
  {
    Serial.println("Ignoring Up Button");
    return;
  }
  if (up)
    if (bManualMotor)
      BlindMove(motor1, BLIND_UP);
    else
      BlindMove(motor2, BLIND_UP);
  else
  {
    BlindsStop();
  }
}


void BlindsMove(int iDirection, int iDuration) {
   motor1.drive(iDirection);
   motor2.drive(iDirection);
   delay(iDuration);
   motor1.brake();
   motor2.brake();
   motor1.standby();
   motor2.standby();
}

void BlindsMove(int iDirection) {
   motor1.drive(iDirection);
   motor2.drive(iDirection);
}

void BlindsStop(void) {
   motor1.brake();
   motor2.brake();
   motor1.standby();
   motor2.standby();
}

void BlindMove(Motor myMotor, int iDirection, int iDuration) {
   myMotor.drive(iDirection);
   delay(iDuration);
   myMotor.brake();
   myMotor.standby();
}

void BlindMove(Motor myMotor, int iDirection) {
   myMotor.drive(iDirection);
}

void BlindStop(Motor myMotor) {
   myMotor.brake();
   myMotor.standby();
}